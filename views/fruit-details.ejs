<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Fruit Details</h1>

    <p>Name: <%= fruit.name %></p>
    <% if(fruit.isReadyToEat) {%>
        <p>Fruit is Ready to Eat!</p>
    <%} else{ %>
        <p>Fruit NOT Ready to Eat!</p>

    <% }%>

    <form action="/fruits/<%= fruit._id %>?_zaid=DELETE" method="post">
        <button>Delete fruit</button>
    </form>

    <form action="/fruits/<%= fruit._id %>/edit" method="get">
        <button>Edit Fruit</button>
    </form>
</body>
</html>